// 02-进阶 · 第 2 章：扩展函数（Receiver.name + 默认值）
Vec2 {
    x:Int
    y:Int
}
fun Vec2.lengthSq():Int {
    return this.x * this.x + this.y * this.y
}
fun Vec2.sum(base:Int = 10):Int {
    return this.x + this.y + base
}
fun main() {
    p = Vec2(3, 4)
    println p.lengthSq()
    println p.sum()
    println p.sum(100)
}
