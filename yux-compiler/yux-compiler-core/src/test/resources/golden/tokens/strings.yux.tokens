2:5 ASSIGN "="
2:7 STRING_LITERAL "\"Hello\\n\\t\\u0041\""
3:1 NEWLINE "\n"
3:1 IDENTIFIER "esc"
3:5 ASSIGN "="
3:7 STRING_LITERAL "\"\\$name\""
