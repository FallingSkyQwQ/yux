fun main() {
    health = 10
    if health <= 0 {
        print "died"
    } else if health < 10 {
        print "low"
    } else {
        print "ok"
    }

    total = 0
    for i in 0..10 {
        total += i
    }

    while total > 0 {
        total -= 1
    }

    when health {
        0 -> print "zero"
        else -> print "other"
    }
}
